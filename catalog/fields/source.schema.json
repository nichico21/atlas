{
  "$schema": "https://json-schema.org/draft/2020-12/schema",

  "title": "FSIP Source Registry",

  "description": "Schema describing one documentary source used by FSIP.",

  "type": "object",

  "required": [
    "id",
    "identification",
    "description",
    "classification",
    "collection",
    "evaluation",
    "development",
    "documentation"
  ],

  "properties": {

    "id": {
      "type": "string"
    },

    "identification": {

      "type": "object",

      "required": [
        "name",
        "acronym",
        "family",
        "mainObject"
      ],

      "properties": {

        "name": {
          "type": "string"
        },

        "acronym": {
          "type": "string"
        },

        "family": {
          "type": "string"
        },

        "mainObject": {
          "type": "string"
        }

      }

    },

    "description": {

      "type": "object",

      "properties": {

        "summary": {
          "type": "string"
        },

        "strategicImportance": {
          "type": "string"
        },

        "questionsAnswered": {
          "type": "string"
        }

      }

    },

    "classification": {

      "type": "object",

      "properties": {

        "mainSectors": {

          "type": "array",

          "items": {
            "type": "string"
          }

        },

        "role": {
          "type": "string"
        },

        "owner": {
          "type": "string"
        },

        "level": {
          "type": "string"
        },

        "url": {
          "type": "string",
          "format": "uri"
        },

        "sourceType": {
          "type": "string"
        },

        "dataTypes": {

          "type": "array",

          "items": {
            "type": "string"
          }

        }

      }

    },

    "collection": {

      "type": "object",

      "properties": {

        "estimatedCompanies": {
          "type": "integer"
        },

        "updateFrequency": {
          "type": "string"
        },

        "access": {

          "type": "array",

          "items": {
            "type": "string"
          }

        },

        "collectionDifficulty": {
          "type": "string"
        }

      }

    },

    "evaluation": {

      "type": "object",

      "properties": {

        "strategicValue": {
          "type": "integer"
        },

        "reliability": {
          "type": "integer"
        },

        "richness": {
          "type": "integer"
        },

        "coverage": {
          "type": "integer"
        },

        "exploitability": {
          "type": "integer"
        },

        "fsipScore": {
          "type": "integer"
        },

        "potential": {

          "type": "object",

          "properties": {

            "rating": {
              "type": "integer"
            },

            "comment": {
              "type": "string"
            }

          }

        }

      }

    },

    "development": {

      "type": "object",

      "properties": {

        "connectorPlanned": {
          "type": "boolean"
        },

        "developmentROI": {
          "type": "integer"
        },

        "priority": {
          "type": "string"
        },

        "status": {
          "type": "string"
        }

      }

    },

    "documentation": {

      "type": "object",

      "properties": {

        "lastReview": {
          "type": "string",
          "format": "date"
        },

        "comments": {
          "type": "string"
        }

      }

    }

  }

}